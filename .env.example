# Public site URL (used for SEO metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional: contact form delivery.
# If set, /api/contact forwards submissions as JSON to this URL
# (e.g. a Formspree / Make / Zapier / n8n / Slack webhook).
# If empty, submissions are logged on the server and the form still succeeds.
CONTACT_WEBHOOK_URL=

# Optional: assistant widget ("Ask me anything").
# If set, /api/assistant forwards { question } to this endpoint and expects { answer }.
# If empty, the widget answers locally from the FAQ in src/config/site.ts.
ASSISTANT_WEBHOOK_URL=
